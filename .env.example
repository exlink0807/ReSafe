NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# simulated | real (real은 아직 미구현 — lib/ai/provider.ts 참고)
TRACE_PROVIDER=simulated

# --- AI 상담: Anthropic(Claude) 또는 Google(Gemini) 둘 중 하나만 채우면 됩니다 ---
# 둘 다 비워두면 AI 상담이 자동으로 규칙 기반 모의 응답(MOCK)으로 동작합니다.
# 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요 — 브라우저에 노출되면 안 되는 서버 전용 키입니다.
# 둘 다 채웠다면 AI_PROVIDER로 우선순위를 명시하세요(anthropic | gemini). 안 적으면 ANTHROPIC_API_KEY를 우선 씁니다.
# AI_PROVIDER=gemini

# Anthropic: https://console.anthropic.com → API Keys (유료, 결제수단 등록 필요)
ANTHROPIC_API_KEY=

# Gemini: https://aistudio.google.com/apikey → Create API key (무료 티어 있음, 해커톤엔 이쪽이 더 간단할 수 있음)
# 모델을 바꾸고 싶으면 GEMINI_MODEL도 설정 가능 (기본값: gemini-2.5-flash)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# 필수: 게시물 URL 등 민감 링크를 DB에 암호화해서 저장하는 데 쓰는 키 (lib/security/crypto.ts).
# 터미널에서 `openssl rand -hex 32` 실행해서 나온 64자리 문자열을 그대로 붙여넣으세요.
# 이 값이 없으면 evidence/trace 관련 API가 암호화 단계에서 에러를 던집니다.
URL_ENCRYPTION_KEY=
