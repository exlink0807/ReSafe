NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# simulated | real (real은 아직 미구현 — lib/ai/provider.ts 참고)
TRACE_PROVIDER=simulated

# 선택사항: 비워두면 AI 상담이 자동으로 규칙 기반 모의 응답(MOCK)으로 동작합니다.
# 값을 채우면 실제 Claude API로 대화형 응답을 생성합니다 (lib/ai/llm.ts 참고).
# 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요 — 브라우저에 노출되면 안 되는 서버 전용 키입니다.
ANTHROPIC_API_KEY=

# 공개 웹 재유포 탐색 (화이트햇 엔진). 비워두면 DEMO 모드(가상 재유포본으로 유사도 계산 시연)로 동작합니다.
# Google Cloud 콘솔에서 Cloud Vision API를 켜고 API 키를 만든 뒤, 키 제한을 'Cloud Vision API'로 걸어 두세요.
# 서버 전용 키입니다. NEXT_PUBLIC_ 접두사를 붙이지 마세요.
GOOGLE_VISION_API_KEY=

# 시연용 AI 가드 OFF 권한 토큰. 비워 두면 화면에서 가드를 꺼도 서버가 항상 켠 채로 처리합니다.
DEMO_TOKEN=
